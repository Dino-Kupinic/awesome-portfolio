---
import Layout from '../layouts/Layout.astro';
// Rendered straight from the repo's guide so there's only one copy.
import { Content } from '../../../CONTRIBUTING.md';
---

<Layout title="Contribution Guide">
	<article class="guide"><Content /></article>
</Layout>

<style>
	/* Minimal prose styles until the design pass; Tailwind's preflight strips them. */
	.guide :global(h1) { display: none; } /* Layout already shows the title */
	.guide :global(h2) { margin: 2rem 0 0.75rem; font-size: 1.5rem; font-weight: 700; }
	.guide :global(p), .guide :global(ul), .guide :global(ol), .guide :global(pre) { margin-bottom: 1rem; }
	.guide :global(ul) { list-style: disc; padding-left: 1.5rem; }
	.guide :global(ol) { list-style: decimal; padding-left: 1.5rem; }
	.guide :global(a) { text-decoration: underline; }
	.guide :global(pre) { padding: 1rem; border-radius: 0.25rem; overflow-x: auto; }
	.guide :global(:not(pre) > code) { background: var(--color-gray-100); padding: 0 0.25rem; border-radius: 0.25rem; }
</style>
