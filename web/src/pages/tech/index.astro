---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { techSlug } from '@/tech';

const counts = new Map<string, number>();
for (const { data } of await getCollection('portfolios')) {
	for (const t of data.techStack) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const used = [...counts].sort(([a], [b]) => a.localeCompare(b));
---

<Layout title="Technologies">
	<ul class="flex flex-wrap justify-center gap-3">
		{used.map(([t, count]) => (
			<li><a href={`/tech/${techSlug(t)}`} class="block rounded-full px-4 py-1.5 ring-1 ring-stone-200 transition hover:text-emerald-600 hover:ring-emerald-600 dark:ring-stone-800 dark:hover:text-emerald-400 dark:hover:ring-emerald-400">{t} <span class="text-stone-500">{count}</span></a></li>
		))}
	</ul>
</Layout>
