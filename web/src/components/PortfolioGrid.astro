---
import { existsSync } from 'node:fs';
import type { CollectionEntry } from 'astro:content';
import { techSlug } from '../tech';

interface Props {
	portfolios: CollectionEntry<'portfolios'>[];
}

// Missing `added` means just merged, before the bot stamps it: show it last.
const portfolios = Astro.props.portfolios.toSorted(
  (a, b) => (a.data.added?.getTime() ?? Date.now()) - (b.data.added?.getTime() ?? Date.now()),
);
---

<ul class="grid gap-x-10 gap-y-16 md:grid-cols-2">
	{portfolios.map(({ id, data }) => (
		<li class="group">
			<a href={data.url} class="block overflow-hidden rounded-2xl shadow-sm ring-1 ring-stone-200 transition group-hover:-translate-y-1 group-hover:shadow-lg dark:ring-stone-800">
				{/* shortcut: cwd-relative check assumes the build runs in web/; fine until 04 fills every Screenshot */}
				{/* aspect-video matches the 1280x720 Screenshots, so nothing is cropped. */}
				{existsSync(`public/screenshots/${id}.png`) ? (
					<img src={`/screenshots/${id}.png`} alt={`Screenshot of ${data.author}'s Portfolio`} class="aspect-video w-full object-cover object-top" loading="lazy" />
				) : (
					<div class="aspect-video bg-stone-200 dark:bg-stone-900" />
				)}
			</a>
			<div class="mt-4 flex items-baseline justify-between gap-4">
				<p class="font-medium">{data.author}</p>
				<a href={data.url} class="truncate text-sm text-stone-500 hover:text-emerald-600 dark:hover:text-emerald-400">{new URL(data.url).hostname.replace(/^www\./, '')}</a>
			</div>
			<p class="mt-1 text-xs text-stone-500">
				{data.techStack.map((t, i) => (
					<>{i > 0 && ' · '}<a href={`/tech/${techSlug(t)}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">{t}</a></>
				))}
			</p>
		</li>
	))}
</ul>
